# Copie este arquivo para `.env` (na mesma pasta) e preencha os valores.
# O `.env` NÃO vai pro git (está no .gitignore) -- nunca coloque chave aqui
# no .env.example.

# Supabase do PokerSync (usado pelos jobs, pela API e pelo --upload dos
# scripts offline)
SUPABASE_URL=https://olgziujndtlvxegcnaoq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave que a API exige no header X-API-Key (servidor) e que o
# scripts/trigger_job.sh envia (cliente)
SOLVER_API_KEY=

# Só pro scripts/trigger_job.sh (padrão: a URL de produção no Railway)
SOLVER_API_URL=https://pokersync-solver-production.up.railway.app
